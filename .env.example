# --- XRPL ---
XRPL_NETWORK=mainnet
XRPL_ENDPOINT=wss://xrplcluster.com

# RLUSD (mainnet) — VERIFY the live issuer before use.
# Currency is the 160-bit hex encoding of "RLUSD".
RLUSD_ISSUER=
RLUSD_CURRENCY=524C555344000000000000000000000000000000

# --- t54 x402 facilitator ---
# Testnet: https://xrpl-facilitator-testnet.t54.ai
# Mainnet: https://xrpl-facilitator-mainnet.t54.ai
# Local:   http://127.0.0.1:8011
T54_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
T54_API_KEY=

# --- Merchant / service account ---
# NEVER commit a real seed. Use a testnet account for development.
PAYPER_ACCOUNT_ADDRESS=
PAYPER_ACCOUNT_SEED=

# --- Backend ---
PORT=8787
# Comma-separated merchant r-addresses the indexer watches.
WATCH_ACCOUNTS=
# CORS origin allowed to read the dashboard endpoints (default *).
CORS_ORIGIN=*

# --- Web dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_XRPL_NETWORK=testnet
