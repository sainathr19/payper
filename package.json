{
  "name": "payper",
  "version": "0.0.0",
  "private": true,
  "description": "Pay-per-call payments for AI agents on XRPL (x402)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm --filter @payper/sdk build && pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist .next .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "license": "MIT"
}
